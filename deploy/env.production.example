# انسخ إلى /var/www/nashawi-tel/.env.production
# ثم غيّر JWT_SECRET بقيمة عشوائية قوية

NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1
DATA_DIR=/var/lib/nashawi-tel
JWT_SECRET=غيّر-هذا-بسلسلة-عشوائية-طويلة-جداً

# رابط JSON لاستيراد أعضاء العائلة من nashawi.xyz (اختياري)
# NASHAWI_MEMBERS_JSON_URL=https://nashawi.xyz/api/members.json
